---
import Project from '../../views/Project.astro';
import { entrySlug, getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects('ja');
  return projects.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---

<Project lang="ja" entry={entry} />

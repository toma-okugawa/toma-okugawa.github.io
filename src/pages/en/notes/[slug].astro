---
import Note from '../../../views/Note.astro';
import { entrySlug, getNotes } from '../../../lib/content';

export async function getStaticPaths() {
  const notes = await getNotes('en');
  return notes.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---

<Note lang="en" entry={entry} />

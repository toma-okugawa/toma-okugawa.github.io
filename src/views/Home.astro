---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { entrySlug, getFeaturedProjects, getNotes, getPage } from '../lib/content';
import { href, isoDate, pick, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const page = await getPage(lang, 'home');
const { Content } = await render(page);
const featured = await getFeaturedProjects(lang);
const notes = (await getNotes(lang)).slice(0, 3);
const siteUrl = Astro.site ?? new URL('https://toma-okugawa.github.io');
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Toma Okugawa',
  alternateName: '奥河 董馬',
  url: new URL(href(lang, '/'), siteUrl).href,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'National Institute of Technology, Yuge College' },
  sameAs: site.links.map((l) => l.url),
};
---

<Base lang={lang} description={page.data.description} jsonld={[person]}>
  <h1>{site.name[lang]} <span class="muted" lang={lang === 'ja' ? 'en' : 'ja'}>{site.nameAlt[lang]}</span></h1>
  <p class="lead">{site.tagline[lang]}</p>
  <p class="meta">{site.affiliation[lang]}</p>

  <Content />

  {
    page.data.now && (
      <p>
        <strong lang="en">{t.now}</strong>
        {page.data.nowDate && (
          <>
            {' '}
            <time class="mono muted" datetime={page.data.nowDate}>
              {page.data.nowDate}
            </time>
          </>
        )}
        {' — '}
        {page.data.now}
      </p>
    )
  }

  <section aria-labelledby="featured">
    <h2 id="featured">{t.featured}</h2>
    <ul class="list">
      {
        featured.map((p) => (
          <li>
            <a href={href(lang, `/projects/${entrySlug(p.id)}/`)}>{p.data.title}</a>{' '}
            <span class="mono muted">{p.data.year}</span>
            <p>{p.data.summary}</p>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href={href(lang, '/projects/')}>{t.allProjects} →</a></p>
  </section>

  {
    notes.length > 0 && (
      <section aria-labelledby="notes">
        <h2 id="notes">{t.latestNotes}</h2>
        <ul class="list">
          {notes.map((n) => (
            <li>
              <time class="mono muted" datetime={isoDate(n.data.date)}>
                {isoDate(n.data.date)}
              </time>{' '}
              <a href={href(lang, `/notes/${entrySlug(n.id)}/`)}>{n.data.title}</a>
            </li>
          ))}
        </ul>
        <p class="more"><a href={href(lang, '/notes/')}>{t.allNotes} →</a></p>
      </section>
    )
  }

  <section aria-labelledby="links">
    <h2 id="links">{t.links}</h2>
    <ul class="inline">
      {
        site.links.map((l) => (
          <li>
            <a href={l.url}>{pick(l.label, lang)}</a>
          </li>
        ))
      }
      {
        site.email && (
          <li>
            <a href={`mailto:${site.email}`}>{t.email}</a>
          </li>
        )
      }
    </ul>
  </section>
</Base>
